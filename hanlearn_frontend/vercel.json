{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "/mandarin-vocabulary-miner/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/mandarin-vocabulary-miner/(.*\\..*)",
      "destination": "/$1"
    },
    {
      "source": "/mandarin-vocabulary-miner/(.*)",
      "destination": "/index.html"
    }
  ]
}